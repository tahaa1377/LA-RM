+def _tie_weight(G, od, weight="weight", scale=1e-6):
+    """Edge weights perturbed by a tiny pair-specific amount, so that paths of
+    equal cost come out in a random (but reproducible) order for this pair while
+    paths of different cost keep their order."""
+    rng = random.Random(zlib.crc32(repr(od).encode()))
+    xi = {e: rng.random() for e in sorted(G.edges(), key=repr)}
+    return lambda u, v, d: d[weight] * (1.0 + scale * xi[(u, v)])
+
+
+def node_protecting(G, s, d, k, max_stretch=None, prio=None, weight="weight"):
+    """Candidate set with node protection and random ties (revision).
+
+    Start from a shortest path (equal-cost ties broken at random for this pair).
+    Then, for the transit switches of that path in decreasing order of priority
+    (here: the share of demand that crosses them under shortest-path routing),
+    add the shortest path that avoids the switch, unless a chosen candidate
+    already avoids it, as long as the path stays within the stretch bound. Fill
+    the remaining slots with Yen's paths (same random ties). Returns the
+    candidates in order of cost."""
+    wf = _tie_weight(G, (s, d), weight)
+    p1 = list(nx.shortest_path(G, s, d, weight=wf))
+    base = path_cost(G, p1, weight)
+    bound = None if max_stretch is None else max_stretch * base
+    chosen = [p1]
+    prio = prio or {}
+    transit = sorted(p1[1:-1], key=lambda n: (-prio.get(n, 0.0), repr(n)))
+    for t in transit:
+        if len(chosen) >= k:
+            break
+        if any(t not in p for p in chosen):
+            continue
+        H = nx.restricted_view(G, [t], [])
+        try:
+            p = list(nx.shortest_path(H, s, d, weight=wf))
+        except nx.NetworkXNoPath:
+            continue
+        if (bound is None or path_cost(G, p, weight) <= bound) and p not in chosen:
+            chosen.append(p)
+    if len(chosen) < k:
+        for p in nx.shortest_simple_paths(G, s, d, weight=wf):
+            p = list(p)
+            if bound is not None and path_cost(G, p, weight) > bound:
+                break
+            if p not in chosen:
+                chosen.append(p)
+            if len(chosen) >= k:
+                break
+    return sorted(chosen, key=lambda p: path_cost(G, p, weight))
+
+
+def diverse(G, s, d, k, max_stretch=None, prio=None, weight="weight"):
+    """Diverse candidate set (revision): node-disjoint paths first, then node
+    protection, then Yen's paths, all with random ties for the pair.
+
+    1. a shortest path P1;
+    2. while slots remain, the shortest path that shares no intermediate switch with
+       the paths chosen so far, if it is within the stretch bound;
+    3. for the transit switches of P1 in decreasing order of priority (the share of
+       demand that crosses them under shortest-path routing), the shortest path that
+       avoids the switch, unless a chosen path already does, within the bound;
+    4. Yen's paths for the remaining slots.
+    Returns the candidates in order of cost."""
+    wf = _tie_weight(G, (s, d), weight)
+    p1 = list(nx.shortest_path(G, s, d, weight=wf))
+    base = path_cost(G, p1, weight)
+    bound = None if max_stretch is None else max_stretch * base
+    ok = lambda p: bound is None or path_cost(G, p, weight) <= bound
+    chosen = [p1]
+    used = set(p1[1:-1])
+    while len(chosen) < k and used:
+        H = nx.restricted_view(G, list(used), [])
+        try:
+            p = list(nx.shortest_path(H, s, d, weight=wf))
+        except nx.NetworkXNoPath:
+            break
+        if not ok(p) or p in chosen:
+            break
+        chosen.append(p)
+        used |= set(p[1:-1])
+    prio = prio or {}
+    for t in sorted(p1[1:-1], key=lambda n: (-prio.get(n, 0.0), repr(n))):
+        if len(chosen) >= k:
+            break
+        if any(t not in p for p in chosen):
+            continue
+        H = nx.restricted_view(G, [t], [])
+        try:
+            p = list(nx.shortest_path(H, s, d, weight=wf))
+        except nx.NetworkXNoPath:
+            continue
+        if ok(p) and p not in chosen:
+            chosen.append(p)
+    if len(chosen) < k:
+        for p in nx.shortest_simple_paths(G, s, d, weight=wf):
+            p = list(p)
+            if not ok(p):
+                break
+            if p not in chosen:
+                chosen.append(p)
+            if len(chosen) >= k:
+                break
+    return sorted(chosen, key=lambda p: path_cost(G, p, weight))
+
+
+def random_ties(G, s, d, k, max_stretch=None, weight="weight"):
+    """Yen's k shortest paths with equal-cost ties broken at random for the pair."""
+    wf = _tie_weight(G, (s, d), weight)
+    out = []
+    base = None
+    for p in nx.shortest_simple_paths(G, s, d, weight=wf):
+        p = list(p)
+        c = path_cost(G, p, weight)
+        base = c if base is None else base
+        if max_stretch is not None and c > max_stretch * base:
+            break
+        out.append(p)
+        if len(out) >= k:
+            break
+    return sorted(out, key=lambda p: path_cost(G, p, weight))
+
+
+def sp_shares(G, ods, lam, weight="weight"):
+    """Share of the demand that crosses each switch under shortest-path routing,
+    equal-cost ties split evenly."""
+    S = {n: 0.0 for n in G.nodes()}
+    tot = sum(lam[od] for od in ods) or 1.0
+    for od in ods:
+        eq = ecmp_paths(G, od[0], od[1], weight)
+        for p in eq:
+            for n in p:
+                S[n] += lam[od] / tot / len(eq)
+    return S
+
